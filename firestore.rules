rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------
    // Access comes from your own users/{uid} doc (status + role), re-checked on
    // every request: approving or revoking someone takes effect immediately.
    // (A missing doc makes get() fail, which denies.)
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function approved() { return signedIn() && me().status == 'approved'; }
    function isAdmin()  { return approved() && me().role == 'admin'; }

    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function isTime(v) { return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------------------------------------------------------------------
    // users/{uid}
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow read: if approved() || (signedIn() && request.auth.uid == uid);

      // Sign-up: you may create only your own profile, as a pending member,
      // with the email you actually signed in with.
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['email', 'displayName', 'photoUrl', 'role', 'status',
                                                             'createdAt', 'approvedAt', 'approvedBy', 'lastReadChatAt'])
                    && request.resource.data.email == request.auth.token.email
                    && isStr(request.resource.data.displayName, 1, 60)
                    && request.resource.data.role == 'member'
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.get('approvedAt', null) == null
                    && request.resource.data.get('approvedBy', null) == null
                    && request.resource.data.get('lastReadChatAt', null) == null;

      // You may update only your own name, profile photo and chat read receipt.
      // The photo is a small image data URL (Storage needs a paid plan): at most
      // ~90 KB, WebP / JPEG / PNG only, or null to remove it.
      allow update: if signedIn() && request.auth.uid == uid
                    && changed().hasOnly(['lastReadChatAt', 'displayName', 'photoUrl'])
                    && (!('displayName' in changed()) || isStr(request.resource.data.displayName, 1, 60))
                    && (!('photoUrl' in changed()) || request.resource.data.photoUrl == null
                        || (isStr(request.resource.data.photoUrl, 30, 120000)
                            && request.resource.data.photoUrl.matches('^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/]+={0,2}$')))
                    // Read receipts use the server clock (serverTimestamp()).
                    && (!('lastReadChatAt' in changed()) || request.resource.data.lastReadChatAt == request.time);

      // Admins approve / reject / revoke / promote others, never themselves.
      allow update: if isAdmin() && request.auth.uid != uid
                    && changed().hasOnly(['status', 'role', 'approvedAt', 'approvedBy'])
                    && request.resource.data.status in ['pending', 'approved', 'rejected']
                    && request.resource.data.role in ['member', 'admin']
                    && (!('approvedAt' in changed()) || request.resource.data.approvedAt == request.time)
                    && (!('approvedBy' in changed()) || request.resource.data.approvedBy == request.auth.uid);

      allow delete: if false;
    }

    // Push notification devices (Web Push subscriptions), one per browser.
    // Only the owner sees or changes them; the push worker reads them with the
    // service account. pushLog/ (the worker's "sent once" locks) has no rules,
    // so browsers can't touch it.
    match /users/{uid}/pushSubscriptions/{subId} {
      function validSubscription(d) {
        return d.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'uid', 'userAgent', 'createdAt'])
            && d.keys().hasAll(['endpoint', 'p256dh', 'auth', 'uid', 'createdAt'])
            && isStr(d.endpoint, 12, 1000) && d.endpoint.matches('^https://.+')
            && isStr(d.p256dh, 80, 100)
            && isStr(d.auth, 16, 40)
            && d.uid == uid
            && (!('userAgent' in d) || isStr(d.userAgent, 0, 200))
            && d.createdAt == request.time;
      }

      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if approved() && request.auth.uid == uid && validSubscription(request.resource.data);
    }

    // ---------------------------------------------------------------------
    // events/{eventId}
    // ---------------------------------------------------------------------
    // Date options are keyed by their first day (candidateDates). A multi-day
    // option also has candidateEnds[firstDay] = lastDay; votes stay keyed by
    // the first day. (Rules can't loop, so the end dates' order and length are
    // checked by the browser; confirming copies the chosen one to finalEndDate.)
    function validNewEvent(d) {
      return d.keys().hasOnly(['title', 'description', 'location', 'status', 'proposedBy',
                               'proposedByName', 'createdAt', 'candidateDates', 'candidateEnds',
                               'finalDate', 'finalEndDate', 'availabilitySummary', 'rsvpSummary'])
          && d.keys().hasAll(['title', 'status', 'proposedBy', 'candidateDates'])
          && d.status == 'proposed'
          && d.proposedBy == request.auth.uid
          && isStr(d.title, 1, 120)
          && (!('description' in d) || isStr(d.description, 0, 2000))
          && (!('location' in d) || isStr(d.location, 0, 200))
          && (!('proposedByName' in d) || isStr(d.proposedByName, 0, 60))
          && (!('createdAt' in d) || d.createdAt == request.time)
          && d.candidateDates is list
          && d.candidateDates.size() >= 1 && d.candidateDates.size() <= 31
          && (!('candidateEnds' in d)
              || (d.candidateEnds is map && d.candidateEnds.keys().hasOnly(d.candidateDates)))
          && (!('finalDate' in d) || d.finalDate == null)
          && (!('finalEndDate' in d) || d.finalEndDate == null)
          // New events start with no votes.
          && (!('availabilitySummary' in d) || (d.availabilitySummary is map && d.availabilitySummary.size() == 0))
          && (!('rsvpSummary' in d) || d.rsvpSummary == {'join': 0, 'notAvailable': 0});
    }

    // A vote before it exists behaves like an empty vote.
    function emptyVote() { return {'availableDates': [], 'rsvp': null}; }
    function isJoin(v) { return v.rsvp == 'join' ? 1 : 0; }
    function isNotAvailable(v) { return v.rsvp == 'not_available' ? 1 : 0; }

    // The availability counts must move exactly with one vote's change:
    // at most one date toggled, and only that date's count changes by ±1.
    function availabilityMatches(oldDates, newDates, oldMap, newMap) {
      // Lists (not sets): rules sets can't be indexed.
      let added = newDates.removeAll(oldDates);
      let removed = oldDates.removeAll(newDates);
      let touched = newMap.diff(oldMap).affectedKeys();
      return added.size() + removed.size() <= 1
          && touched.hasOnly(added.concat(removed))
          && touched.hasAll(added.concat(removed))
          && (added.size() == 0 || newMap.get(added[0], 0) == oldMap.get(added[0], 0) + 1)
          && (removed.size() == 0 || newMap.get(removed[0], 0) == oldMap.get(removed[0], 0) - 1);
    }

    function summariesMatch(oldVote, newVote, oldEvent, newEvent) {
      return availabilityMatches(oldVote.availableDates, newVote.availableDates,
                                 oldEvent.availabilitySummary, newEvent.availabilitySummary)
          && newEvent.rsvpSummary.join - oldEvent.rsvpSummary.join == isJoin(newVote) - isJoin(oldVote)
          && newEvent.rsvpSummary.notAvailable - oldEvent.rsvpSummary.notAvailable
               == isNotAvailable(newVote) - isNotAvailable(oldVote);
    }

    match /events/{eventId} {
      function eventPath() { return /databases/$(db)/documents/events/$(eventId); }
      function votePath(uid) { return /databases/$(db)/documents/events/$(eventId)/votes/$(uid); }
      function event() { return get(eventPath()).data; }

      allow read: if approved();
      allow create: if approved() && validNewEvent(request.resource.data);

      function canManage() { return isAdmin() || resource.data.proposedBy == request.auth.uid; }

      // Confirm: admin or proposer, proposed -> confirmed on one date option;
      // finalEndDate is that option's last day (= finalDate for one day). Pages
      // from before multi-day events send no finalEndDate: fine for one day.
      function chosenEnd() {
        return resource.data.get('candidateEnds', {}).get(request.resource.data.finalDate, null);
      }
      allow update: if approved() && canManage()
                    && changed().hasOnly(['status', 'finalDate', 'finalEndDate'])
                    && resource.data.status == 'proposed'
                    && request.resource.data.status == 'confirmed'
                    && request.resource.data.finalDate in resource.data.candidateDates
                    && (request.resource.data.get('finalEndDate', null) == null
                        ? chosenEnd() == null
                        : request.resource.data.finalEndDate
                            == (chosenEnd() == null ? request.resource.data.finalDate : chosenEnd()));

      // Cancel: admin or proposer, proposed/confirmed -> cancelled.
      allow update: if approved() && canManage()
                    && changed().hasOnly(['status'])
                    && resource.data.status in ['proposed', 'confirmed']
                    && request.resource.data.status == 'cancelled';

      // Everyone else may only update the cached summaries, together with
      // their own vote in the same write, by exactly the amount that vote
      // changed.
      allow update: if approved()
                    && changed().hasOnly(['availabilitySummary', 'rsvpSummary'])
                    && (resource.data.status == 'proposed' || !('availabilitySummary' in changed()))
                    && (resource.data.status == 'confirmed' || !('rsvpSummary' in changed()))
                    && getAfter(votePath(request.auth.uid)).data.updatedAt == request.time
                    && summariesMatch(
                         exists(votePath(request.auth.uid)) ? get(votePath(request.auth.uid)).data : emptyVote(),
                         getAfter(votePath(request.auth.uid)).data,
                         resource.data,
                         request.resource.data);

      allow delete: if isAdmin();

      // One vote doc per user (doc ID == uid).
      match /votes/{uid} {
        function validVote(before, d, e) {
          return d.keys().hasOnly(['displayName', 'availableDates', 'rsvp', 'updatedAt'])
              && d.keys().hasAll(['availableDates', 'rsvp', 'updatedAt'])
              && (!('displayName' in d) || isStr(d.displayName, 0, 60))
              && d.availableDates is list
              && d.availableDates.size() <= 31
              && d.availableDates.hasOnly(e.candidateDates)
              && (d.rsvp == null || d.rsvp in ['join', 'not_available'])
              && d.updatedAt == request.time
              // Availability while proposed; RSVP once confirmed. Nothing when cancelled.
              && ((e.status == 'proposed' && d.rsvp == before.rsvp)
                  || (e.status == 'confirmed' && d.availableDates == before.availableDates))
              // A vote that changes anything must update the event summaries in
              // the same write (the event rule checks the amounts).
              && ((d.availableDates == before.availableDates && d.rsvp == before.rsvp)
                  || getAfter(eventPath()).data.diff(e).affectedKeys().size() > 0);
        }

        allow read: if approved();

        allow create, update: if approved() && uid == request.auth.uid
          && validVote(resource == null ? emptyVote() : resource.data, request.resource.data, event());

        // Deleting would leave the summaries counting a vote that no longer exists.
        allow delete: if false;
      }

      // Any approved member may plan a confirmed event's day(s). Items must sit
      // on one of its days (finalDate..finalEndDate; events confirmed before
      // multi-day events have only finalDate); end time (if any) after the start.
      match /itinerary/{itemId} {
        function validItem(d) {
          let e = event();
          return d.keys().hasOnly(['date', 'startTime', 'endTime', 'activity', 'location', 'notes', 'order', 'createdBy'])
              && d.keys().hasAll(['date', 'startTime', 'activity', 'order', 'createdBy'])
              && e.status == 'confirmed'
              && isDate(d.date)
              && (e.get('finalEndDate', null) == null
                  ? d.date == e.finalDate
                  : (d.date >= e.finalDate && d.date <= e.finalEndDate))
              && isTime(d.startTime)
              && (!('endTime' in d) || d.endTime == null || (isTime(d.endTime) && d.endTime > d.startTime))
              && isStr(d.activity, 1, 200)
              && (!('location' in d) || isStr(d.location, 0, 200))
              && (!('notes' in d) || isStr(d.notes, 0, 1000))
              && d.order is number;
        }

        allow read, delete: if approved();

        allow create: if approved()
          && validItem(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;

        allow update: if approved()
          && validItem(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.date == resource.data.date;
      }

      // Shared expenses of a confirmed event (whole sen). The payer must be an
      // approved member; splitWith lists who shares the cost (checked by the
      // browser: rules can't loop). The person who added it, the payer or the
      // admin may change or remove it.
      match /expenses/{expenseId} {
        function validExpense(d) {
          return d.keys().hasOnly(['item', 'amountCents', 'paidBy', 'splitWith', 'notes', 'createdBy', 'createdAt'])
              && d.keys().hasAll(['item', 'amountCents', 'paidBy', 'splitWith', 'createdBy', 'createdAt'])
              && event().status == 'confirmed'
              && isStr(d.item, 1, 120)
              && d.amountCents is int && d.amountCents > 0 && d.amountCents <= 100000000
              && d.paidBy is string
              && d.splitWith is list && d.splitWith.size() >= 1 && d.splitWith.size() <= 50
              && (!('notes' in d) || isStr(d.notes, 0, 300));
        }
        function approvedMember(uid) {
          return get(/databases/$(db)/documents/users/$(uid)).data.status == 'approved';
        }
        function canEdit() {
          return resource.data.createdBy == request.auth.uid || resource.data.paidBy == request.auth.uid || isAdmin();
        }

        allow read: if approved();

        allow create: if approved()
          && validExpense(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && approvedMember(request.resource.data.paidBy);

        allow update: if approved() && canEdit()
          && validExpense(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && (!('paidBy' in changed()) || approvedMember(request.resource.data.paidBy));

        allow delete: if approved() && canEdit();
      }

      // Payments recorded between members ("Zikri paid Mirza RM85"). Only the
      // payer, the receiver or the admin records one; it can be undone by
      // whoever recorded it (or the admin), never edited.
      match /settlements/{settlementId} {
        allow read: if approved();

        allow create: if approved()
          && request.resource.data.keys().hasOnly(['from', 'to', 'amountCents', 'createdBy', 'createdAt'])
          && request.resource.data.keys().hasAll(['from', 'to', 'amountCents', 'createdBy', 'createdAt'])
          && event().status == 'confirmed'
          && request.resource.data.from is string && request.resource.data.to is string
          && request.resource.data.from != request.resource.data.to
          && (request.auth.uid in [request.resource.data.from, request.resource.data.to] || isAdmin())
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0 && request.resource.data.amountCents <= 100000000
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && get(/databases/$(db)/documents/users/$(request.resource.data.from)).data.status == 'approved'
          && get(/databases/$(db)/documents/users/$(request.resource.data.to)).data.status == 'approved';

        allow update: if false;
        allow delete: if approved() && (resource.data.createdBy == request.auth.uid || isAdmin());
      }

      // Shared "who brings what" checklist of a confirmed event. Any approved
      // member may add, edit, tick off and delete items. The PIC (if any) must
      // be an approved member when assigned.
      match /checklist/{itemId} {
        function validChecklistItem(d) {
          return d.keys().hasOnly(['item', 'quantity', 'picUid', 'done', 'notes', 'order', 'createdBy'])
              && d.keys().hasAll(['item', 'done', 'order', 'createdBy'])
              && event().status == 'confirmed'
              && isStr(d.item, 1, 120)
              && (!('quantity' in d) || isStr(d.quantity, 0, 40))
              && (!('notes' in d) || isStr(d.notes, 0, 500))
              && d.done is bool
              && d.order is number;
        }

        function validPic(d) {
          return d.get('picUid', null) == null
              || (d.picUid is string
                  && get(/databases/$(db)/documents/users/$(d.picUid)).data.status == 'approved');
        }

        allow read, delete: if approved();

        allow create: if approved()
          && validChecklistItem(request.resource.data)
          && validPic(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;

        allow update: if approved()
          && validChecklistItem(request.resource.data)
          && (!('picUid' in changed()) || validPic(request.resource.data))
          && request.resource.data.createdBy == resource.data.createdBy;
      }
    }

    // ---------------------------------------------------------------------
    // chats/{room}/messages/{msgId}
    // ---------------------------------------------------------------------
    match /chats/{room}/messages/{msgId} {
      allow read: if approved();

      // One group room. The sender name must be your own display name (no
      // impersonation), text must contain something other than whitespace.
      allow create: if approved()
                    && room == 'main'
                    && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'createdAt'])
                    && request.resource.data.keys().hasAll(['senderId', 'senderName', 'text', 'createdAt'])
                    && request.resource.data.senderId == request.auth.uid
                    && isStr(request.resource.data.senderName, 0, 60)
                    && request.resource.data.senderName
                         == get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('displayName', '')
                    && isStr(request.resource.data.text, 1, 1000)
                    && request.resource.data.text.matches('(?s).*\\S.*')
                    && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }
  }
}
