rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------
    function signedIn() { return request.auth != null; }
    function approved() { return signedIn() && request.auth.token.approved == true; }
    function isAdmin()  { return signedIn() && request.auth.token.admin == true; }

    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function isTime(v) { return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------------------------------------------------------------------
    // users/{uid}  — created and approved by the server (Admin SDK) only
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow read: if approved() || (signedIn() && request.auth.uid == uid);

      // Members may only update their own lastReadChatAt / displayName.
      allow update: if signedIn() && request.auth.uid == uid
                    && changed().hasOnly(['lastReadChatAt', 'displayName'])
                    && (!('displayName' in changed()) || isStr(request.resource.data.displayName, 1, 60))
                    && (!('lastReadChatAt' in changed()) || request.resource.data.lastReadChatAt is timestamp);

      allow create, delete: if false;
    }

    // ---------------------------------------------------------------------
    // events/{eventId}
    // ---------------------------------------------------------------------
    function validNewEvent(d) {
      return d.keys().hasOnly(['title', 'description', 'location', 'status', 'proposedBy',
                               'proposedByName', 'createdAt', 'candidateDates', 'finalDate',
                               'availabilitySummary', 'rsvpSummary'])
          && d.keys().hasAll(['title', 'status', 'proposedBy', 'candidateDates'])
          && d.status == 'proposed'
          && d.proposedBy == request.auth.uid
          && isStr(d.title, 1, 120)
          && (!('description' in d) || isStr(d.description, 0, 2000))
          && (!('location' in d) || isStr(d.location, 0, 200))
          && (!('proposedByName' in d) || isStr(d.proposedByName, 0, 60))
          && (!('createdAt' in d) || d.createdAt == request.time)
          && d.candidateDates is list
          && d.candidateDates.size() >= 1 && d.candidateDates.size() <= 31
          && (!('finalDate' in d) || d.finalDate == null)
          && (!('availabilitySummary' in d) || d.availabilitySummary is map)
          && (!('rsvpSummary' in d) || d.rsvpSummary is map);
    }

    match /events/{eventId} {
      function event() { return get(/databases/$(db)/documents/events/$(eventId)).data; }

      allow read: if approved();
      allow create: if approved() && validNewEvent(request.resource.data);

      // status / finalDate changes are server-only; clients may only update
      // the cached summaries.
      allow update: if approved()
                    && changed().hasOnly(['availabilitySummary', 'rsvpSummary'])
                    && request.resource.data.availabilitySummary is map
                    && request.resource.data.rsvpSummary is map;

      allow delete: if isAdmin();

      // One vote doc per user (doc ID == uid).
      match /votes/{uid} {
        allow read: if approved();

        allow create, update: if approved() && uid == request.auth.uid
          && event().status != 'cancelled'
          && request.resource.data.keys().hasOnly(['displayName', 'availableDates', 'rsvp', 'updatedAt'])
          && isStr(request.resource.data.displayName, 0, 60)
          && request.resource.data.availableDates is list
          && request.resource.data.availableDates.hasOnly(event().candidateDates)
          && (request.resource.data.rsvp == null
              || (request.resource.data.rsvp in ['join', 'not_available'] && event().status == 'confirmed'))
          && request.resource.data.updatedAt == request.time;

        allow delete: if approved() && uid == request.auth.uid;
      }

      match /itinerary/{itemId} {
        allow read, delete: if approved();

        allow create, update: if approved()
          && request.resource.data.keys().hasOnly(['date', 'startTime', 'endTime', 'activity',
                                                   'location', 'notes', 'order', 'createdBy'])
          && isDate(request.resource.data.date)
          && isTime(request.resource.data.startTime)
          && (request.resource.data.endTime == null || isTime(request.resource.data.endTime))
          && isStr(request.resource.data.activity, 1, 200)
          && isStr(request.resource.data.location, 0, 200)
          && isStr(request.resource.data.notes, 0, 1000)
          && request.resource.data.order is number
          && (resource == null
                ? request.resource.data.createdBy == request.auth.uid
                : request.resource.data.createdBy == resource.data.createdBy);
      }
    }

    // ---------------------------------------------------------------------
    // chats/{room}/messages/{msgId}
    // ---------------------------------------------------------------------
    match /chats/{room}/messages/{msgId} {
      allow read: if approved();

      allow create: if approved()
                    && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'createdAt'])
                    && request.resource.data.senderId == request.auth.uid
                    && isStr(request.resource.data.senderName, 0, 60)
                    && isStr(request.resource.data.text, 1, 1000)
                    && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }
  }
}
