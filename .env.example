# Firebase web app config (Firebase console → Project settings → Your apps → Web).
# These are public by design; security comes from Auth + firestore.rules.
# Copy to .env and fill in. Used by `npm run dev` and `npm run build`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=false

# Push notifications (workers/push). Leave empty to hide the feature.
# VITE_PUSH_URL: the worker URL printed by `npm run push:deploy`.
# VITE_VAPID_PUBLIC_KEY: printed by `node scripts/generate-vapid.mjs` (public by design).
VITE_PUSH_URL=
VITE_VAPID_PUBLIC_KEY=
