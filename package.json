{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "emulators": "firebase emulators:start --only auth,firestore --project demo-planly --import=./emulator-data --export-on-exit=./emulator-data",
        "emulators:fresh": "firebase emulators:start --only auth,firestore --project demo-planly",
        "dev:all": "concurrently -k -n emu,vite -c yellow,magenta \"npm run emulators\" \"npm run dev:emulators\"",
        "test:rules": "firebase emulators:exec --only firestore --project demo-planly \"node --test --test-concurrency=1 tests/rules/*.test.mjs\"",
        "make-admin": "node scripts/make-admin.mjs",
        "deploy": "firebase deploy --only hosting,firestore:rules,firestore:indexes",
        "dev:emulators": "vite --mode emulators",
        "icons": "node scripts/generate-icons.mjs"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^5.0.2",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "firebase-admin": "^14.4.0",
        "firebase-tools": "^15.30.2",
        "sharp": "^0.35.4",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@alpinejs/focus": "^3.17.4",
        "@fullcalendar/core": "^6.1.21",
        "@fullcalendar/daygrid": "^6.1.21",
        "@fullcalendar/interaction": "^6.1.21",
        "@fullcalendar/list": "^6.1.21",
        "@fullcalendar/timegrid": "^6.1.21",
        "alpinejs": "^3.17.4",
        "firebase": "^12.19.0"
    },
    "name": "planly"
}
