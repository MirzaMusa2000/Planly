{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "emulators": "firebase emulators:start --project demo-planly --import=./emulator-data --export-on-exit=./emulator-data",
        "emulators:fresh": "firebase emulators:start --project demo-planly",
        "dev:all": "concurrently -k -n emu,php,vite -c yellow,blue,magenta \"npm run emulators\" \"php artisan serve\" \"npm run dev\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "firebase-tools": "^15.30.2",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@alpinejs/focus": "^3.17.4",
        "@fullcalendar/core": "^6.1.21",
        "@fullcalendar/daygrid": "^6.1.21",
        "@fullcalendar/interaction": "^6.1.21",
        "@fullcalendar/list": "^6.1.21",
        "@fullcalendar/timegrid": "^6.1.21",
        "alpinejs": "^3.17.4",
        "firebase": "^12.19.0"
    },
    "name": "planly"
}
